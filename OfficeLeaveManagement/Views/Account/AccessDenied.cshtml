@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <i class="bi bi-shield-lock text-danger" style="font-size: 5rem;"></i>
            </div>
            <h2>Access Denied</h2>
            <p class="text-muted">You do not have permission to access this page.</p>
            <p class="text-muted">Please contact your administrator if you believe this is an error.</p>
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary mt-3">
                <i class="bi bi-box-arrow-in-right me-2"></i>Back to Login
            </a>
        </div>
    </div>
</div>
