@model List<OfficeLeaveManagement.Models.LeaveType>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Leave Type Management</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Add Leave Type
    </a>
</div>

<div class="card mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">Leave Types</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Leave Name</th>
                        <th>Description</th>
                        <th>Annual Allocation</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var lt in Model)
                        {
                            <tr>
                                <td>@lt.LeaveTypeId</td>
                                <td>@lt.LeaveName</td>
                                <td>@lt.Description</td>
                                <td>@lt.AnnualAllocation days</td>
                                <td>
                                    @if (lt.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@lt.LeaveTypeId" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No leave types found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
