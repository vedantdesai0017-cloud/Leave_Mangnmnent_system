@using OfficeLeaveManagement.Models
@model List<LeaveApplication>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>All Leave Requests</h2>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-2">
                <label for="employeeId" class="form-label">Employee</label>
                <select name="employeeId" id="employeeId" class="form-select">
                    <option value="">All</option>
                    @if(ViewBag.Employees != null)
                    {
                        foreach(var emp in (List<Employee>)ViewBag.Employees)
                        {
                            if(ViewBag.EmployeeFilter != null && (int)ViewBag.EmployeeFilter == emp.EmployeeId)
                            {
                                <option value="@emp.EmployeeId" selected>@emp.FullName</option>
                            }
                            else
                            {
                                <option value="@emp.EmployeeId">@emp.FullName</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="departmentId" class="form-label">Department</label>
                <select name="departmentId" id="departmentId" class="form-select">
                    <option value="">All</option>
                    @if(ViewBag.Departments != null)
                    {
                        foreach(var dept in (List<Department>)ViewBag.Departments)
                        {
                            if(ViewBag.DepartmentFilter != null && (int)ViewBag.DepartmentFilter == dept.DepartmentId)
                            {
                                <option value="@dept.DepartmentId" selected>@dept.DepartmentName</option>
                            }
                            else
                            {
                                <option value="@dept.DepartmentId">@dept.DepartmentName</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="leaveTypeId" class="form-label">Leave Type</label>
                <select name="leaveTypeId" id="leaveTypeId" class="form-select">
                    <option value="">All</option>
                    @if(ViewBag.LeaveTypes != null)
                    {
                        foreach(var lt in (List<LeaveType>)ViewBag.LeaveTypes)
                        {
                            if(ViewBag.LeaveTypeFilter != null && (int)ViewBag.LeaveTypeFilter == lt.LeaveTypeId)
                            {
                                <option value="@lt.LeaveTypeId" selected>@lt.LeaveName</option>
                            }
                            else
                            {
                                <option value="@lt.LeaveTypeId">@lt.LeaveName</option>
                            }
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label for="status" class="form-label">Status</label>
                <select name="status" id="status" class="form-select">
                    <option value="">All</option>
                    @foreach (var status in Enum.GetValues(typeof(LeaveStatus)))
                    {
                        if(ViewBag.StatusFilter != null && ViewBag.StatusFilter.ToString() == status.ToString())
                        {
                            <option value="@status" selected>@status</option>
                        }
                        else
                        {
                            <option value="@status">@status</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <div class="row g-2">
                    <div class="col-6">
                        <label for="startDate" class="form-label">Start</label>
                        <input type="date" name="startDate" id="startDate" class="form-control" value="@ViewBag.StartDateFilter" />
                    </div>
                    <div class="col-6">
                        <label for="endDate" class="form-label">End</label>
                        <input type="date" name="endDate" id="endDate" class="form-control" value="@ViewBag.EndDateFilter" />
                    </div>
                </div>
            </div>
            <div class="col-md-1">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i></button>
            </div>
        </form>

        <div class="table-responsive table-container">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Days</th>
                        <th>Status</th>
                        <th>Applied Date</th>
                        <th>Reviewed By</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model != null && Model.Any())
                    {
                        foreach(var app in Model)
                        {
                            <tr>
                                <td>@app.EmployeeName</td>
                                <td>@app.LeaveTypeName</td>
                                <td>@app.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@app.EndDate.ToString("dd MMM yyyy")</td>
                                <td>@app.NumberOfDays</td>
                                <td>
                                    @if(app.Status == LeaveStatus.Pending) { <span class="badge bg-warning">Pending</span> }
                                    else if(app.Status == LeaveStatus.Approved) { <span class="badge bg-success">Approved</span> }
                                    else if(app.Status == LeaveStatus.Rejected) { <span class="badge bg-danger">Rejected</span> }
                                    else { <span class="badge bg-secondary">@app.Status</span> }
                                </td>
                                <td>@app.AppliedDate.ToString("dd MMM yyyy")</td>
                                <td>@(app.ReviewedBy ?? "-")</td>
                                <td>
                                    <a asp-controller="Leave" asp-action="Details" asp-route-id="@app.LeaveApplicationId" class="btn btn-sm btn-outline-primary">View</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-3">No leave requests found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
