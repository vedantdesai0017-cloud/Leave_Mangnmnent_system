@using OfficeLeaveManagement.ViewModels
@model List<LeaveBalanceViewModel>

<div class="mb-4">
    <h2>Leave Balances</h2>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end mb-4">
            <div class="col-md-6">
                <label for="search" class="form-label">Search Employee</label>
                <div class="input-group">
                    <input type="text" name="search" id="search" class="form-control" placeholder="Name or Code" value="@ViewBag.SearchTerm">
                    <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Search</button>
                </div>
            </div>
        </form>

        @if (Model.Any())
        {
            <div class="accordion" id="leaveBalancesAccordion">
                @foreach (var item in Model)
                {
                    var headingId = $"heading{item.EmployeeId}";
                    var collapseId = $"collapse{item.EmployeeId}";
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="@headingId">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                <strong>@item.EmployeeName (@item.EmployeeCode)</strong> &nbsp;-&nbsp; @item.DepartmentName
                            </button>
                        </h2>
                        <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headingId" data-bs-parent="#leaveBalancesAccordion">
                            <div class="accordion-body">
                                <div class="table-responsive">
                                    <table class="table table-bordered table-sm mb-0 align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Leave Type</th>
                                                <th>Total</th>
                                                <th>Used</th>
                                                <th>Remaining</th>
                                                <th style="width: 25%;">Progress</th>
                                                <th>Year</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var balance in item.Balances)
                                            {
                                                var progress = balance.TotalLeaves > 0 ? (balance.UsedLeaves * 100 / balance.TotalLeaves) : 0;
                                                <tr>
                                                    <td>@balance.LeaveTypeName</td>
                                                    <td>@balance.TotalLeaves</td>
                                                    <td>@balance.UsedLeaves</td>
                                                    <td><span class="badge bg-success">@balance.RemainingLeaves</span></td>
                                                    <td>
                                                        <div class="progress" style="height: 10px;">
                                                            <div class="progress-bar @(progress > 80 ? "bg-danger" : "bg-primary")" role="progressbar" style="width: @progress%;" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                                                        </div>
                                                    </td>
                                                    <td>@balance.Year</td>
                                                    <td>
                                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editBalanceModal" 
                                                            data-empid="@item.EmployeeId" data-empname="@item.EmployeeName" data-leavetypeid="@balance.LeaveBalanceId" data-leavetypename="@balance.LeaveTypeName" data-total="@balance.TotalLeaves">
                                                            <i class="bi bi-pencil"></i> Edit
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">No employee leave balances found.</div>
        }
    </div>
</div>

<!-- Edit Balance Modal -->
<div class="modal fade" id="editBalanceModal" tabindex="-1" aria-labelledby="editBalanceModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form asp-action="UpdateBalance" method="post">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="editBalanceModalLabel">Edit Leave Balance</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="modalEmployeeId" name="employeeId" />
                    <input type="hidden" id="modalLeaveTypeId" name="leaveTypeId" />
                    
                    <div class="mb-3">
                        <label class="form-label">Employee</label>
                        <input type="text" id="modalEmployeeName" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Leave Type</label>
                        <input type="text" id="modalLeaveTypeName" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label for="newTotal" class="form-label">Total Leaves</label>
                        <input type="number" id="modalTotal" name="newTotal" class="form-control" min="0" step="1" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var editModal = document.getElementById('editBalanceModal');
            editModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var empId = button.getAttribute('data-empid');
                var empName = button.getAttribute('data-empname');
                var leaveTypeId = button.getAttribute('data-leavetypeid');
                var leaveTypeName = button.getAttribute('data-leavetypename');
                var total = button.getAttribute('data-total');

                editModal.querySelector('#modalEmployeeId').value = empId;
                editModal.querySelector('#modalEmployeeName').value = empName;
                editModal.querySelector('#modalLeaveTypeId').value = leaveTypeId;
                editModal.querySelector('#modalLeaveTypeName').value = leaveTypeName;
                editModal.querySelector('#modalTotal').value = total;
            });
        });
    </script>
}
