@using OfficeLeaveManagement.Models
@using OfficeLeaveManagement.ViewModels
@model AdminDashboardViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Admin Dashboard</h2>
</div>

<div class="row mb-4">
    <div class="col-md-2 mb-3">
        <div class="card text-white bg-primary h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase text-white-50">Total Employees</h6>
                        <h3 class="mb-0">@Model.TotalEmployees</h3>
                    </div>
                    <i class="bi bi-people fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="card text-white bg-info h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase text-white-50">Total Depts</h6>
                        <h3 class="mb-0">@Model.TotalDepartments</h3>
                    </div>
                    <i class="bi bi-building fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="card text-white bg-warning h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase text-white-50">Pending</h6>
                        <h3 class="mb-0">@Model.PendingRequests</h3>
                    </div>
                    <i class="bi bi-hourglass-split fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="card text-white bg-success h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase text-white-50">Approved</h6>
                        <h3 class="mb-0">@Model.ApprovedRequests</h3>
                    </div>
                    <i class="bi bi-check-circle fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="card text-white bg-danger h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase text-white-50">Rejected</h6>
                        <h3 class="mb-0">@Model.RejectedRequests</h3>
                    </div>
                    <i class="bi bi-x-circle fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="card text-white bg-secondary h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-uppercase text-white-50">On Leave Today</h6>
                        <h3 class="mb-0">@Model.EmployeesOnLeave</h3>
                    </div>
                    <i class="bi bi-calendar-event fs-1 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-lg-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Leave Status Distribution</h5>
            </div>
            <div class="card-body d-flex justify-content-center align-items-center">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Department-wise Leaves</h5>
            </div>
            <div class="card-body">
                <canvas id="deptChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4 mb-3">
        <div class="card h-100 shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Monthly Leave Trends</h5>
            </div>
            <div class="card-body">
                <canvas id="monthlyChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0">Recent Leave Applications</h5>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Days</th>
                        <th>Status</th>
                        <th>Applied Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if(Model.RecentApplications.Any())
                    {
                        foreach(var app in Model.RecentApplications)
                        {
                            <tr>
                                <td>@app.EmployeeName</td>
                                <td>@app.LeaveTypeName</td>
                                <td>@app.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@app.EndDate.ToString("dd MMM yyyy")</td>
                                <td>@app.NumberOfDays</td>
                                <td>
                                    @if(app.Status == LeaveStatus.Pending) { <span class="badge bg-warning">Pending</span> }
                                    else if(app.Status == LeaveStatus.Approved) { <span class="badge bg-success">Approved</span> }
                                    else if(app.Status == LeaveStatus.Rejected) { <span class="badge bg-danger">Rejected</span> }
                                    else { <span class="badge bg-secondary">@app.Status</span> }
                                </td>
                                <td>@app.AppliedDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <a asp-controller="Leave" asp-action="Details" asp-route-id="@app.LeaveApplicationId" class="btn btn-sm btn-outline-primary">View</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-3">No recent applications found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof renderDoughnutChart === 'function') {
                renderDoughnutChart('statusChart',
                    @Html.Raw(Json.Serialize(Model.StatusLabels)),
                    @Html.Raw(Json.Serialize(Model.StatusCounts)),
                    ['#f8961e', '#2ec4b6', '#e63946', '#6c757d']);
            }
            if (typeof renderBarChart === 'function') {
                renderBarChart('deptChart',
                    @Html.Raw(Json.Serialize(Model.DepartmentLabels)),
                    @Html.Raw(Json.Serialize(Model.DepartmentLeaveCounts)),
                    'Leave Applications', '#4361ee');
            }
            if (typeof renderLineChart === 'function') {
                renderLineChart('monthlyChart',
                    @Html.Raw(Json.Serialize(Model.MonthlyLabels)),
                    @Html.Raw(Json.Serialize(Model.MonthlyLeaveCounts)),
                    'Monthly Leaves', '#2ec4b6');
            }
        });
    </script>
}
