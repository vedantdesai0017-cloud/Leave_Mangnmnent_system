@using OfficeLeaveManagement.ViewModels
@using OfficeLeaveManagement.Models
@model EmployeeDashboardViewModel

<div class="mb-4">
    <h2>Welcome back, @Model.EmployeeName</h2>
    <p class="text-muted">Employee Code: @Model.EmployeeCode | Department: @Model.DepartmentName</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card bg-primary text-white h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-white-50 mb-1">Total Leave</h6>
                        <h3 class="stat-value mb-0">@Model.TotalLeaves</h3>
                    </div>
                    <div><i class="bi bi-calendar3 fs-1 opacity-50"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card bg-warning text-dark h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-dark-50 mb-1">Used Leave</h6>
                        <h3 class="stat-value mb-0">@Model.UsedLeaves</h3>
                    </div>
                    <div><i class="bi bi-calendar-x fs-1 opacity-50"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card bg-success text-white h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-white-50 mb-1">Remaining Leave</h6>
                        <h3 class="stat-value mb-0">@Model.RemainingLeaves</h3>
                    </div>
                    <div><i class="bi bi-calendar-check fs-1 opacity-50"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card bg-info text-white h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-white-50 mb-1">Pending</h6>
                        <h3 class="stat-value mb-0">@Model.PendingRequests</h3>
                    </div>
                    <div><i class="bi bi-hourglass-split fs-1 opacity-50"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card bg-success text-white h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-white-50 mb-1">Approved</h6>
                        <h3 class="stat-value mb-0">@Model.ApprovedRequests</h3>
                    </div>
                    <div><i class="bi bi-check-circle fs-1 opacity-50"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 col-lg-2">
        <div class="card bg-danger text-white h-100 shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="card-title text-white-50 mb-1">Rejected</h6>
                        <h3 class="stat-value mb-0">@Model.RejectedRequests</h3>
                    </div>
                    <div><i class="bi bi-x-circle fs-1 opacity-50"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<h4 class="mb-3">Leave Balances</h4>
<div class="row g-3 mb-4">
    @foreach (var balance in Model.LeaveBalances)
    {
        double percentage = balance.TotalLeaves > 0 ? (double)balance.UsedLeaves / balance.TotalLeaves * 100 : 0;
        double remainingPercentage = 100 - percentage;
        
        string bgClass = "bg-success";
        if (remainingPercentage < 25)
        {
            bgClass = "bg-danger";
        }
        else if (remainingPercentage <= 50)
        {
            bgClass = "bg-warning";
        }

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">@balance.LeaveTypeName</h6>
                    <div class="progress mb-2" style="height: 10px;">
                        <div class="progress-bar @bgClass" role="progressbar" style="width: @percentage%" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    <div class="small text-muted d-flex justify-content-between">
                        <span>Used: @balance.UsedLeaves / Total: @balance.TotalLeaves</span>
                        <span class="fw-bold">Remaining: @balance.RemainingLeaves</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="card content-card shadow-sm border-0 mb-4">
    <div class="card-header bg-white border-bottom-0 d-flex justify-content-between align-items-center pt-3 pb-0">
        <h5 class="mb-0">Recent Leave Applications</h5>
        <a asp-controller="Leave" asp-action="Apply" class="btn btn-sm btn-primary">Apply Leave</a>
    </div>
    <div class="card-body">
        @if (Model.RecentApplications.Any())
        {
            <div class="table-responsive table-container">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Leave Type</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Days</th>
                            <th>Status</th>
                            <th>Applied Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var leave in Model.RecentApplications)
                        {
                            <tr>
                                <td>@leave.LeaveTypeName</td>
                                <td>@leave.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@leave.EndDate.ToString("dd MMM yyyy")</td>
                                <td>@leave.NumberOfDays</td>
                                <td>
                                    @{
                                        string badgeClass = leave.Status switch
                                        {
                                            LeaveStatus.Pending => "badge bg-info text-dark",
                                            LeaveStatus.Approved => "badge bg-success",
                                            LeaveStatus.Rejected => "badge bg-danger",
                                            LeaveStatus.Cancelled => "badge bg-secondary",
                                            _ => "badge bg-secondary"
                                        };
                                    }
                                    <span class="@badgeClass">@leave.Status</span>
                                </td>
                                <td>@leave.AppliedDate.ToString("dd MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                <p>No leave applications found.</p>
            </div>
        }
    </div>
</div>
