@model List<OfficeLeaveManagement.Models.LeaveApplication>
@using OfficeLeaveManagement.Models

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>All Leave Requests</h2>
        <div class="w-25">
            <input type="text" id="searchInput" class="form-control" placeholder="Search requests..." onkeyup="filterTable()">
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover mb-0" id="requestsTable">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Days</th>
                        <th>Status</th>
                        <th>Applied Date</th>
                        <th>Reviewed Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var req in Model)
                        {
                            <tr>
                                <td>@req.EmployeeName</td>
                                <td>@req.LeaveTypeName</td>
                                <td>@req.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@req.EndDate.ToString("dd MMM yyyy")</td>
                                <td>@req.NumberOfDays</td>
                                <td>
                                    @if (req.Status == LeaveStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (req.Status == LeaveStatus.Approved)
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (req.Status == LeaveStatus.Rejected)
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Cancelled</span>
                                    }
                                </td>
                                <td>@req.AppliedDate.ToString("dd MMM yyyy")</td>
                                <td>@(req.ReviewedDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>
                                    <a asp-controller="Leave" asp-action="Details" asp-route-id="@req.LeaveApplicationId" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">No leave requests found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable() {
            var input, filter, table, tr, td, i, txtValue;
            input = document.getElementById("searchInput");
            filter = input.value.toUpperCase();
            table = document.getElementById("requestsTable");
            tr = table.getElementsByTagName("tr");
            
            for (i = 1; i < tr.length; i++) {
                tr[i].style.display = "none";
                td = tr[i].getElementsByTagName("td");
                for (var j = 0; j < td.length - 1; j++) {
                    if (td[j]) {
                        txtValue = td[j].textContent || td[j].innerText;
                        if (txtValue.toUpperCase().indexOf(filter) > -1) {
                            tr[i].style.display = "";
                            break;
                        }
                    }
                }
            }
        }
    </script>
}
