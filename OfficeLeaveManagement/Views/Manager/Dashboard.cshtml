@model OfficeLeaveManagement.ViewModels.ManagerDashboardViewModel

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-1">Welcome, @Model.ManagerName</h2>
            <p class="text-muted">Department: @Model.DepartmentName</p>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-warning text-white h-100 shadow-sm border-0">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold mb-1">Pending Approvals</div>
                        <div class="h3 mb-0">@Model.PendingApprovals</div>
                    </div>
                    <div class="display-4 opacity-50">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-info text-white h-100 shadow-sm border-0">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold mb-1">Employees On Leave</div>
                        <div class="h3 mb-0">@Model.EmployeesOnLeave</div>
                    </div>
                    <div class="display-4 opacity-50">
                        <i class="bi bi-person-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-success text-white h-100 shadow-sm border-0">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold mb-1">Approved</div>
                        <div class="h3 mb-0">@Model.ApprovedRequests</div>
                    </div>
                    <div class="display-4 opacity-50">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card bg-danger text-white h-100 shadow-sm border-0">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase small fw-bold mb-1">Rejected</div>
                        <div class="h3 mb-0">@Model.RejectedRequests</div>
                    </div>
                    <div class="display-4 opacity-50">
                        <i class="bi bi-x-circle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts and Overview -->
    <div class="row mb-4">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Department Leave Statistics</h5>
                </div>
                <div class="card-body">
                    <canvas id="deptLeaveChart" style="min-height: 250px;"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Team Overview</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-column justify-content-center align-items-center h-100">
                        <h1 class="display-1 text-primary">@Model.TotalEmployees</h1>
                        <p class="lead text-muted">Total Employees in @Model.DepartmentName</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Requests Table -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Pending Leave Requests</h5>
            <a asp-action="PendingRequests" class="btn btn-sm btn-outline-primary">View All</a>
        </div>
        <div class="card-body p-0 table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Days</th>
                        <th>Reason</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PendingLeaveApplications != null && Model.PendingLeaveApplications.Any())
                    {
                        foreach (var req in Model.PendingLeaveApplications.Take(5))
                        {
                            <tr>
                                <td>@req.EmployeeName</td>
                                <td>@req.LeaveTypeName</td>
                                <td>@req.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@req.EndDate.ToString("dd MMM yyyy")</td>
                                <td>@req.NumberOfDays</td>
                                <td><span class="d-inline-block text-truncate" style="max-width: 150px;" title="@req.Reason">@req.Reason</span></td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="Leave" asp-action="Details" asp-route-id="@req.LeaveApplicationId" class="btn btn-outline-secondary" title="View Details"><i class="bi bi-eye"></i></a>
                                        <form asp-action="Approve" method="post" class="d-inline ms-1">
                                            <input type="hidden" name="applicationId" value="@req.LeaveApplicationId" />
                                            <button type="submit" class="btn btn-outline-success" title="Approve"><i class="bi bi-check-lg"></i></button>
                                        </form>
                                        <button type="button" class="btn btn-outline-danger ms-1" title="Reject" onclick="openRejectModal(@req.LeaveApplicationId)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No pending requests.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Reject" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="rejectModalLabel">Reject Leave Request</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="rejectAppId" name="applicationId" />
                    <div class="mb-3">
                        <label for="managerComment" class="form-label">Reason for Rejection (Required)</label>
                        <textarea class="form-control" id="managerComment" name="managerComment" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
    <script>
        var labels = @Html.Raw(Json.Serialize(Model.DepartmentLabels));
        var data = @Html.Raw(Json.Serialize(Model.DepartmentLeaveCounts));
        if (typeof renderBarChart === 'function') {
            renderBarChart('deptLeaveChart', labels, data, 'Leave Applications', '#4361ee');
        }

        function openRejectModal(appId) {
            document.getElementById('rejectAppId').value = appId;
            var modal = new bootstrap.Modal(document.getElementById('rejectModal'));
            modal.show();
        }
    </script>
}
