@{
    var userRole = Context.Session.GetString("UserRole");
    var userName = Context.Session.GetString("UserName");
    var isLoggedIn = !string.IsNullOrEmpty(userRole);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Office Leave Management</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
</head>
<body>
    @if (isLoggedIn)
    {
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-brand p-3 text-white fs-4 font-weight-bold mb-3 d-flex align-items-center">
                <i class="bi bi-calendar-check me-2"></i> Leave Manager
            </div>
            <ul class="nav flex-column">
                @{ var activeMenu = ViewData["ActiveMenu"]?.ToString(); }
                @if (userRole == "Employee")
                {
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "EmployeeDashboard" ? "active" : "")" asp-controller="Employee" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "ApplyLeave" ? "active" : "")" asp-controller="Leave" asp-action="Apply">
                            <i class="bi bi-plus-circle me-2"></i> Apply Leave
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "MyLeaves" ? "active" : "")" asp-controller="Leave" asp-action="MyLeaves">
                            <i class="bi bi-list-check me-2"></i> My Leaves
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "LeaveBalance" ? "active" : "")" asp-controller="Employee" asp-action="Balance">
                            <i class="bi bi-pie-chart me-2"></i> Leave Balance
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "Profile" ? "active" : "")" asp-controller="Employee" asp-action="Profile">
                            <i class="bi bi-person me-2"></i> Profile
                        </a>
                    </li>
                    <hr class="text-white-50" />
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-left me-2"></i> Logout
                        </a>
                    </li>
                }
                else if (userRole == "Manager")
                {
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "ManagerDashboard" ? "active" : "")" asp-controller="Manager" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "PendingRequests" ? "active" : "")" asp-controller="Manager" asp-action="PendingRequests">
                            <i class="bi bi-hourglass-split me-2"></i> Pending Requests
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "LeaveRequests" ? "active" : "")" asp-controller="Manager" asp-action="LeaveRequests">
                            <i class="bi bi-list-ul me-2"></i> Leave Requests
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "EmployeeHistory" ? "active" : "")" asp-controller="Manager" asp-action="EmployeeHistory">
                            <i class="bi bi-clock-history me-2"></i> Employee History
                        </a>
                    </li>
                    <hr class="text-white-50" />
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-left me-2"></i> Logout
                        </a>
                    </li>
                }
                else if (userRole == "Admin")
                {
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "AdminDashboard" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
                            <i class="bi bi-speedometer2 me-2"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item mt-3 mb-1 px-3 text-uppercase text-muted" style="font-size: 0.75rem;">MANAGEMENT</li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "Employees" ? "active" : "")" asp-controller="Admin" asp-action="Employees">
                            <i class="bi bi-people me-2"></i> Employees
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "Departments" ? "active" : "")" asp-controller="Department" asp-action="Index">
                            <i class="bi bi-building me-2"></i> Departments
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "LeaveTypes" ? "active" : "")" asp-controller="LeaveType" asp-action="Index">
                            <i class="bi bi-tags me-2"></i> Leave Types
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "LeaveBalances" ? "active" : "")" asp-controller="Admin" asp-action="LeaveBalances">
                            <i class="bi bi-wallet2 me-2"></i> Leave Balances
                        </a>
                    </li>
                    <li class="nav-item mt-3 mb-1 px-3 text-uppercase text-muted" style="font-size: 0.75rem;">REQUESTS</li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "AllLeaves" ? "active" : "")" asp-controller="Admin" asp-action="AllLeaves">
                            <i class="bi bi-inbox me-2"></i> All Leave Requests
                        </a>
                    </li>
                    <li class="nav-item mt-3 mb-1 px-3 text-uppercase text-muted" style="font-size: 0.75rem;">ANALYTICS</li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "Reports" ? "active" : "")" asp-controller="Report" asp-action="Index">
                            <i class="bi bi-graph-up me-2"></i> Reports
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeMenu == "AuditLogs" ? "active" : "")" asp-controller="Audit" asp-action="Index">
                            <i class="bi bi-shield-check me-2"></i> Audit Logs
                        </a>
                    </li>
                    <hr class="text-white-50" />
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Logout">
                            <i class="bi bi-box-arrow-left me-2"></i> Logout
                        </a>
                    </li>
                }
            </ul>
        </nav>
        
        <div id="sidebarOverlay" class="sidebar-overlay"></div>
        
        <div class="main-content">
            <!-- Top bar -->
            <div class="topbar">
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-dark d-lg-none me-2" id="sidebarToggle">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <h5 class="mb-0">@ViewData["Title"]</h5>
                </div>
                <div class="user-info">
                    <span class="role-badge badge bg-secondary me-2">@userRole</span>
                    <span class="d-none d-md-inline me-2">@userName</span>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-box-arrow-left"></i>
                    </a>
                </div>
            </div>
            
            <!-- Alerts -->
            <div class="container-fluid p-4">
                <partial name="_Alerts" />
                @RenderBody()
            </div>
            
            <!-- Footer -->
            <div class="footer text-center mt-auto p-3">
                <small class="text-muted">&copy; @DateTime.Now.Year Office Leave Management System | ASP.NET Core MVC</small>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <!-- Custom JS -->
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
